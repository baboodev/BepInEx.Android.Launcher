<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Audio -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Camera (some games use it) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Storage -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Keep device awake -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android 14+: game registers a screen-capture observer during StartUp -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

    <uses-feature android:glEsVersion="0x00030000" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />

    <!-- Android 11+: discover all launchable apps for Unity IL2CPP detection -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.BepInEx.Launcher">

        <meta-data android:name="com.google.android.gms.version" android:value="12451000" />

        <!-- Bootstrap activity (FusionCore injection entry point).
             Runs in :game so the game's native runtime (Unity/il2cpp) gets a
             fresh process every launch; exiting the game kills only :game. -->
        <activity
            android:name="com.bepinex.android.BootstrapActivity"
            android:exported="true"
            android:process=":game"
            android:launchMode="standard"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Main launcher activity (Compose UI) -->
        <activity
            android:name="com.bepinex.android.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Accept shared .dll files -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Placeholder for unregistered game launcher activities.
             InstrumentationHooks rewrites startActivity to this stub, then
             restores the real game Activity in Instrumentation.newActivity.
             Runs in :game (same process as BootstrapActivity). -->
        <activity
            android:name="com.bepinex.android.StubActivity"
            android:theme="@style/UnityThemeSelector"
            android:process=":game"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            android:hardwareAccelerated="true"
            android:launchMode="standard"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="false" />

        <!-- Secondary stub used when the running game starts its own activities.
             GameRuntime wraps those intents into this component and substitutes
             the real activity instance during creation. -->
        <activity
            android:name="com.bepinex.android.SecondaryStubActivity"
            android:theme="@style/UnityThemeSelector"
            android:process=":game"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density"
            android:hardwareAccelerated="true"
            android:launchMode="standard"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="false" />

        <!-- Handles desktop shortcut intents for modpack quick-launch -->
        <activity
            android:name="com.bepinex.android.ShortcutLauncherActivity"
            android:exported="true"
            android:launchMode="standard"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Rotate-to-PiP mod remote panel (default process, not :game). -->
        <activity
            android:name="com.bepinex.android.ModRemoteActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BepInEx.Launcher"
            android:excludeFromRecents="true"
            android:taskAffinity="com.bepinex.android.modremote"
            android:configChanges="keyboard|keyboardHidden|screenSize" />

        <!-- In-process login-xdsdk WebView (intercepts bugtopia:// redirect).
             Must be :game — same process as GoogleSignImpl pending callback. -->
        <activity
            android:name="com.bepinex.android.auth.XdOAuthWebActivity"
            android:exported="false"
            android:process=":game"
            android:launchMode="singleTop"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <!-- Deep-link fallback if something still opens bugtopia:// externally. -->
        <activity
            android:name="com.bepinex.android.auth.XdOAuthCallbackActivity"
            android:exported="true"
            android:process=":game"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bugtopia" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- Game SDKs resolve these by PackageManager before startActivity.
             GameRuntime.wrap rewrites them to SecondaryStubActivity and
             newActivity loads the real class from the game ClassLoader. -->
        <activity
            android:name="com.facebook.FacebookActivity"
            android:process=":game"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="com.facebook.CustomTabActivity"
            android:process=":game"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fbconnect" android:host="cct.${applicationId}" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.taptap.sdk.ui.TapTapActivity"
            android:process=":game"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- File provider for DLL sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
