    <!-- About -->
    <string name="about_title">Bugtopia</string>
    <string name="about_description">Heartopia용 Android 런처입니다. Bugtopia 모드와 모드팩, 계정 프로필을 불러옵니다.</string>
    <string name="about_disclaimer">Bugtopia는 Heartopia 공식 앱이 아닙니다.</string>
    <string name="about_version">버전 %1$s</string>
    <string name="about_package">org.bugtopia.mod</string>
    <string name="about_news">Bugtopia 소식</string>
    <string name="about_news_desc">Telegram 채널</string>
    <string name="about_url_telegram">https://t.me/bugtopiamod</string>
    <string name="about_credits_intro">Heartopia용 Bugtopia는 이 프로젝트들 위에 만들어졌습니다. 만든 분들께 감사합니다.</string>
    <string name="about_projects_section">감사</string>
    <string name="about_project_bepinex_name">BepInEx</string>
    <string name="about_project_bepinex_desc">Unity IL2CPP 모딩 프레임워크 — 핵심 플러그인 로더. BepInEx 팀의 BepInEx 6.0.0-pre.2.</string>
    <string name="about_project_fusioncore_name">FusionCore</string>
    <string name="about_project_fusioncore_desc">Starlight 팀의 Android Unity IL2CPP 런타임 컨테이너. 주입 체인, Pine 훅, NativeLoader 구조의 주요 참고 자료입니다.</string>
    <string name="about_project_nextbep_name">NextBep (BepInEx.Android)</string>
    <string name="about_project_nextbep_desc">이 앱의 기반이 된 Android BepInEx 런처입니다. NextBep 만든 분들께 감사합니다.</string>
    <string name="about_project_dotnet_name">dotnet/runtime</string>
    <string name="about_project_dotnet_desc">Microsoft .NET Runtime v10.0.5. Android 16의 BoringSSL SIGSEGV를 고치기 위해 OpenSSL 암호화 백엔드로 소스에서 빌드했습니다.</string>
    <string name="about_project_openssl_name">OpenSSL</string>
    <string name="about_project_openssl_desc">OpenSSL 3.4.0 — ARM64 Android 암호화를 위해 BoringSSL을 대체합니다. libcrypto.so + libssl.so.</string>
    <string name="about_project_pine_name">Pine</string>
    <string name="about_project_pine_desc">ART Java 메서드 훅 프레임워크 (top.canyie.pine:core:0.3.0). ClassLoader, PackageManager, UnityPlayer 훅에 사용됩니다.</string>
    <string name="about_project_dobby_name">Dobby</string>
    <string name="about_project_dobby_desc">ARM64용 네이티브 훅 프레임워크. libnextbep의 il2cpp_init 훅에 사용됩니다.</string>
    <string name="about_project_cpp2il_name">Cpp2IL</string>
    <string name="about_project_cpp2il_desc">IL2CPP 리버스 엔지니어링 도구. interop 어셈블리 생성에 사용됩니다.</string>
