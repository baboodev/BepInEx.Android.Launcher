    <!-- About -->
    <string name="about_title">Bugtopia</string>
    <string name="about_description">Launcher de Android para Heartopia. Carrega o mod Bugtopia, com pacotes de mods e perfis de conta.</string>
    <string name="about_disclaimer">Bugtopia não é um app oficial de Heartopia.</string>
    <string name="about_version">Versão %1$s</string>
    <string name="about_package">org.bugtopia.mod</string>
    <string name="about_news">Notícias do Bugtopia</string>
    <string name="about_news_desc">Canal do Telegram</string>
    <string name="about_url_telegram">https://t.me/bugtopiamod</string>
    <string name="about_credits_intro">Bugtopia para Heartopia foi feito sobre estes projetos. Obrigado aos autores.</string>
    <string name="about_projects_section">Agradecimentos</string>
    <string name="about_project_bepinex_name">BepInEx</string>
    <string name="about_project_bepinex_desc">Framework de mods Unity IL2CPP — o carregador principal de plugins. BepInEx 6.0.0-pre.2 da equipe BepInEx.</string>
    <string name="about_project_fusioncore_name">FusionCore</string>
    <string name="about_project_fusioncore_desc">Contêiner de runtime Unity IL2CPP para Android da equipe Starlight. Referência principal da cadeia de injeção, dos hooks do Pine e da arquitetura do NativeLoader.</string>
    <string name="about_project_nextbep_name">NextBep (BepInEx.Android)</string>
    <string name="about_project_nextbep_desc">Launcher de BepInEx para Android no qual este app se baseia. Obrigado aos autores do NextBep.</string>
    <string name="about_project_dotnet_name">dotnet/runtime</string>
    <string name="about_project_dotnet_desc">Microsoft .NET Runtime v10.0.5. Compilado do código-fonte com o backend criptográfico OpenSSL para corrigir o SIGSEGV do BoringSSL no Android 16.</string>
    <string name="about_project_openssl_name">OpenSSL</string>
    <string name="about_project_openssl_desc">OpenSSL 3.4.0 — substitui o BoringSSL na criptografia ARM64 do Android. libcrypto.so + libssl.so.</string>
    <string name="about_project_pine_name">Pine</string>
    <string name="about_project_pine_desc">Framework de hooks de métodos Java no ART (top.canyie.pine:core:0.3.0). Usado nos hooks de ClassLoader, PackageManager e UnityPlayer.</string>
    <string name="about_project_dobby_name">Dobby</string>
    <string name="about_project_dobby_desc">Framework de hooks nativos para ARM64. Usado no hook de il2cpp_init em libnextbep.</string>
    <string name="about_project_cpp2il_name">Cpp2IL</string>
    <string name="about_project_cpp2il_desc">Ferramenta de engenharia reversa de IL2CPP. Usada para gerar os assemblies de interop.</string>
    <string name="about_url_bepinex">https://github.com/BepInEx/BepInEx</string>
    <string name="about_url_fusioncore">https://github.com/All-Of-Us-Mods/FusionCore</string>
