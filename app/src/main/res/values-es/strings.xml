    <!-- About -->
    <string name="about_title">Bugtopia</string>
    <string name="about_description">Launcher de Android para Heartopia. Carga el mod Bugtopia, con paquetes de mods y perfiles de cuenta.</string>
    <string name="about_disclaimer">Bugtopia no es una aplicación oficial de Heartopia.</string>
    <string name="about_version">Versión %1$s</string>
    <string name="about_package">org.bugtopia.mod</string>
    <string name="about_news">Noticias de Bugtopia</string>
    <string name="about_news_desc">Canal de Telegram</string>
    <string name="about_url_telegram">https://t.me/bugtopiamod</string>
    <string name="about_credits_intro">Bugtopia para Heartopia se basa en estos proyectos. Gracias a sus autores.</string>
    <string name="about_projects_section">Agradecimientos</string>
    <string name="about_project_bepinex_name">BepInEx</string>
    <string name="about_project_bepinex_desc">Framework de mods Unity IL2CPP: el cargador principal de plugins. BepInEx 6.0.0-pre.2 del equipo de BepInEx.</string>
    <string name="about_project_fusioncore_name">FusionCore</string>
    <string name="about_project_fusioncore_desc">Contenedor de runtime Unity IL2CPP para Android del equipo Starlight. Referencia principal de la cadena de inyección, los hooks de Pine y la arquitectura de NativeLoader.</string>
    <string name="about_project_nextbep_name">NextBep (BepInEx.Android)</string>
    <string name="about_project_nextbep_desc">Launcher de BepInEx para Android en el que se basa esta app. Gracias a los autores de NextBep.</string>
    <string name="about_project_dotnet_name">dotnet/runtime</string>
    <string name="about_project_dotnet_desc">Microsoft .NET Runtime v10.0.5. Compilado desde el código fuente con el backend criptográfico OpenSSL para corregir el SIGSEGV de BoringSSL en Android 16.</string>
    <string name="about_project_openssl_name">OpenSSL</string>
    <string name="about_project_openssl_desc">OpenSSL 3.4.0: sustituye a BoringSSL para la criptografía ARM64 en Android. libcrypto.so + libssl.so.</string>
    <string name="about_project_pine_name">Pine</string>
    <string name="about_project_pine_desc">Framework de hooks de métodos Java en ART (top.canyie.pine:core:0.3.0). Se usa en los hooks de ClassLoader, PackageManager y UnityPlayer.</string>
    <string name="about_project_dobby_name">Dobby</string>
    <string name="about_project_dobby_desc">Framework de hooks nativos para ARM64. Se usa en el hook de il2cpp_init dentro de libnextbep.</string>
    <string name="about_project_cpp2il_name">Cpp2IL</string>
    <string name="about_project_cpp2il_desc">Herramienta de ingeniería inversa de IL2CPP. Se usa para generar los ensamblados de interop.</string>
    <string name="about_url_bepinex">https://github.com/BepInEx/BepInEx</string>
    <string name="about_url_fusioncore">https://github.com/All-Of-Us-Mods/FusionCore</string>
    <string name="about_url_nextbep">https://github.com/NextBep/BepInEx.Android</string>
