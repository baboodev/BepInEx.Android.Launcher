<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ SplashScreen API only allows a solid color for the system
      splash background; the animated icon is always circularly masked.
      System splash stays black with an empty icon (no circle of art) and is
      removed on the first content frame. That frame is the full artwork
      (bg_splash); windowBackground is the same drawable for the gap before
      Compose draws. Manifest theme on MainActivity.
      https://developer.android.com/develop/ui/views/launch/splash-screen
    -->
    <style name="Theme.BepInEx.Launcher.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.BepInEx.Launcher</item>
        <!-- API &lt; 31 compat: starting window shows the full art immediately. -->
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <!-- Applied by installSplashScreen(); full-bleed art until setContent. -->
    <style name="Theme.BepInEx.Launcher" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- FusionCore-compatible Unity theme (matches their UnityThemeSelector) -->
    <style name="UnityThemeSelector" parent="BaseUnityTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="BaseUnityTheme" parent="android:Theme.Holo.Light.NoActionBar.Fullscreen">
    </style>
</resources>
